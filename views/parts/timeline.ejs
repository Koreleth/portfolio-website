<div class="about-cv">
    <p class="eyebrow">Lebenslauf</p>

    <ol class="cv">
    <% data.forEach((item, index) => { %>
        <li class="cv-item<%= index === 0 ? ' is-open' : '' %>">
            <button class="cv-head" type="button" aria-expanded="<%= index === 0 %>" aria-controls="cv-<%= item.id %>">
                <span class="cv-year"><%= item.time %></span>
                <span class="cv-title"><%= item.title %></span>
                <span class="cv-icon" aria-hidden="true"></span>
            </button>
            <div class="cv-body" id="cv-<%= item.id %>">
                <div><%- include('rich-text', { text: item.description }) %></div>
            </div>
        </li>
    <% }); %>
    </ol>
</div>
