<%# Mehrzeiliger Text (zerlegt in utils/rich-text.js): Absätze mit Zeilenumbrüchen, Aufzählungen mit Unterpunkten, Links %>
<% parseRichText(locals.text).forEach((node) => { %>
<% if (node.type === 'list') { %><%- include('rich-list', { list: node }) %><% } else { %><p><%- include('rich-lines', { lines: node.lines }) %></p><% } %>
<% }); %>
