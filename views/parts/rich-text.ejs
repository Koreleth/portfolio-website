<%# Mehrzeiliger Text: eine Leerzeile beginnt einen neuen Absatz, einfache Zeilenumbrüche bleiben erhalten %>
<% String(locals.text || '').split(/\r?\n\s*\r?\n/).filter((paragraph) => paragraph.trim()).forEach((paragraph) => { %>
<p><% paragraph.trim().split(/\r?\n/).forEach((line, index) => { %><% if (index > 0) { %><br><% } %><%= line %><% }); %></p>
<% }); %>
