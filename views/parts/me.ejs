<%# Inhalte aus models/about.json – im Admin-Bereich unter „Über mich“ bearbeitbar %>
<div class="about-code">
    <% if (about.photo) { %>
    <figure class="about-photo">
        <img src="<%= about.photo %>" alt="Portrait von Korel" loading="lazy">
        <% if (about.photoCaption) { %><figcaption><%= about.photoCaption %></figcaption><% } %>
    </figure>
    <% } %>
        <aside class="sidebar">
            <div class="editor-bar">
                <i></i><i></i><i></i>
                <em><%= about.fileName %></em>
            </div>

        <%# Der Code wird beim Hineinscrollen Zeile für Zeile getippt (siehe script.js) %>
        <p class="text" data-text="<%= about.code %>"></p>
        </aside>
</div>
