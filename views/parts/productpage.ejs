
<div class="upperpart">
    <div class="titletext">
    <%- include('breadcrumb', { items: [
        { label: 'Start', href: '/' },
        { label: 'Portfolio', href: '/portfolio' },
        { label: data.categorie.name, href: '/portfolio/' + data.categorie.slug },
        { label: data.title }
    ] }) %>
    <p class="eyebrow">Projekt</p>
    <h1><%= data.title %></h1>
    <p><%= data.description %></p>

    <% if (data.tools && data.tools.length > 0) { %>
    <p class="eyebrow tools-label">Verwendete Tools</p>
    <ul class="tools">
        <% data.tools.forEach((tool) => { %>
        <li class="tool"><%- include('tool-icon', { tool: tool }) %><%= tool.name %></li>
        <% }); %>
    </ul>
    <% } %>

    <% if (locals.isAdmin) { %>
    <a class="btn btn-dark btn-small edit-link" href="/admin/projekte/<%= data.id %>/bearbeiten">Projekt bearbeiten</a>
    <% } %>
    </div>

    <div class="titleimg"> <img src="<%= data.images[0] %>" alt="<%= data.title %>"></div>
</div>

<div class="middlepart">
    <div class="middleimg"> <img src="<%= data.images[0] %>" alt="<%= data.title %>"></div>

    <div class="middletext">
        <h2><%= data.title %></h2>
        <p><%= data.text %></p>
    </div>
</div>

<div class="midsec">
    <p>test</p>
</div>

<div class="carousell">

</div>
