<%#
  Projektseite. Kopf, Projekttext und alle Abschnitte liegen im selben Raster aus drei gleich breiten
  Spalten (⅓, ⅔ oder ganze Breite, siehe style.css). Alle Bilder haben ein festes Format;
  ein Klick zeigt das ganze Foto (zoom-image.ejs, lightbox.ejs).
  Oben füllt der Eyecatcher mit dem Titelbild einen ganzen Bildschirm, der Projekttext folgt darunter.
%>
<%# Danach geht es weiter: zum Projekttext oder – ohne ihn – zu den Abschnitten (Ziel des Pfeils im Eyecatcher
    und des Sprungs beim Scrollen, siehe script.js) %>
<% const hasText = data.text || data.images[1]; %>
<% const hasSections = data.sections && data.sections.length > 0; %>
<%# coverFit „contain“ zeigt das Titelbild vollständig (z. B. Logos) auf hellem Grund %>
<div class="project-top" data-fit="<%= data.coverFit === 'contain' ? 'contain' : 'cover' %>">

    <%# Eyecatcher: ein ganzer Bildschirm mit dem Titelbild; Titel und Kurzbeschreibung stehen dezent unten links
        darauf (auf dem Handy mittig). Ein Klick aufs Bild zeigt es ganz %>
    <div class="project-hero">
        <a class="project-hero-media" href="<%= data.images[0] %>" data-zoom data-caption="" draggable="false">
            <img class="project-hero-image" src="<%= data.images[0] %>" alt="<%= data.title %>" draggable="false">
            <img class="project-hero-backdrop" src="<%= data.images[0] %>" alt="" draggable="false">
            <span class="sr-only"> – ganzes Bild anzeigen</span>
        </a>

        <div class="upperpart">
            <div class="titletext">
                <%# Seitenpfad als Überzeile; die aktuelle Seite ist der Titel darunter %>
                <div class="breadcrumb hero-path" role="navigation" aria-label="Seitenpfad">
                    <ol>
                        <li><a href="/portfolio">Portfolio</a></li>
                        <li><a href="/portfolio/<%= data.categorie.slug %>"><%= data.categorie.name %></a></li>
                    </ol>
                </div>
                <h1><%= data.title %></h1>
                <p><%= data.description %></p>

                <% if (data.tools && data.tools.length > 0) { %>
                <ul class="tools" aria-label="Verwendete Tools">
                    <% data.tools.forEach((tool) => { %>
                    <li class="tool"><%- include('tool-icon', { tool: tool }) %><%= tool.name %></li>
                    <% }); %>
                </ul>
                <% } %>

                <% if (locals.isAdmin) { %>
                <a class="btn btn-small edit-link" href="/admin/projekte/<%= data.id %>/bearbeiten">Projekt bearbeiten</a>
                <% } %>
            </div>
        </div>

        <% if (hasText || hasSections) { %>
        <a class="hero-next" href="#weiter" aria-label="Weiter zum Projekt"><span aria-hidden="true"></span></a>
        <% } %>
    </div>

    <% if (hasText) { %>
    <div class="middlepart" id="weiter">
        <%# Zweites Bild; ohne eigenes zweites Bild wird das Titelbild verwendet %>
        <div class="middleimg"><%- include('zoom-image', { src: data.images[1] || data.images[0], alt: data.title, caption: '', lazy: true, focusable: true }) %></div>

        <div class="middletext">
            <%# Eigene Überschrift über dem Projekttext; ohne steht hier der Titel des Projekts %>
            <h2><%= data.textTitle || data.title %></h2>
            <%- include('rich-text', { text: data.text }) %>
        </div>
    </div>
    <% } %>
</div>

<% if (hasSections) { %>
<%# Weitere Abschnitte aus dem Admin-Bereich: je Abschnitt ein Spalten-Layout, pro Spalte Bausteine untereinander.
    Vor dem ersten Abschnitt steht immer ein Trennstrich, vor weiteren nur mit „divider“ %>
<div class="project-sections"<%- hasText ? '' : ' id="weiter"' %>>
    <% data.sections.forEach((section) => { %>
    <section class="psection psection--<%= section.layout %><%= section.valign === 'center' ? ' psection--center' : '' %><%= section.divider ? ' psection--divider' : '' %>">
        <% section.columns.forEach((column) => { %>
        <div class="psection-col">
            <% column.forEach((block) => { %>
            <%- include('block', { block: block, fallbackAlt: data.title }) %>
            <% }); %>
        </div>
        <% }); %>
    </section>
    <% }); %>
</div>
<% } %>

<% if (data.thanks || data.credits.length > 0) { %>
<%# Abspann wie im Film, nach dem letzten Abschnitt mit Strich darüber: oben die Danksagung, darunter die Mitwirkenden –
    links die Rolle, rechts der Name. Mehrere Namen mit derselben Rolle stehen untereinander unter einer Rolle %>
<% const creditGroups = data.credits.reduce((groups, credit) => {
    const last = groups[groups.length - 1];
    if (last && credit.role && last.role === credit.role) last.names.push(credit.name);
    else groups.push({ role: credit.role, names: [credit.name] });
    return groups;
}, []); %>
<div class="project-credits">
    <section class="credits">
        <% if (data.thanks) { %>
        <div class="credits-thanks">
            <div class="credits-thanks-text"><%- include('rich-text', { text: data.thanks }) %></div>
        </div>
        <% } %>
        <% if (creditGroups.length > 0) { %>
        <div class="credits-roll">
            <h2 class="credits-label">Mitwirkende</h2>
            <dl class="credits-list">
                <% creditGroups.forEach((group) => { %>
                <div class="credits-group">
                    <dt><%= group.role %></dt>
                    <% group.names.forEach((name) => { %><dd><%= name %></dd><% }); %>
                </div>
                <% }); %>
            </dl>
        </div>
        <% } %>
    </section>
</div>
<% } %>

<% if (locals.moreProjects && moreProjects.length > 0) { %>
<%# Am Seitenende: die nächsten Projekte (Reihenfolge wie in der Portfolio-Übersicht) als kleine Karten, daneben der
    Weg zu allen. Kein <section>: dort bekäme die Überschrift eine Nummer %>
<div class="more-projects">
    <div class="more-projects-head">
        <h2>Weitere Projekte</h2>
        <a class="more-projects-all" href="/portfolio">Alle ansehen <span aria-hidden="true">&rarr;</span></a>
    </div>
    <div class="more-projects-grid">
        <% moreProjects.forEach((project) => { %>
        <a class="more-project" href="<%= project.url %>">
            <span class="more-project-img" data-fit="<%= project.coverFit %>"><img src="<%= project.image %>" alt="" loading="lazy" draggable="false"></span>
            <strong><%= project.title %></strong>
            <small><%= project.categorie %></small>
        </a>
        <% }); %>
    </div>
</div>
<% } %>

<%- include('lightbox') %>
