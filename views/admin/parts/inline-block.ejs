<%#
  Ein Baustein im Bearbeitungsmodus, dargestellt wie auf der Projektseite; die Inhalte sind direkt bearbeitbar.
  Parameter: key (Baustein-Schlüssel), block ({ type, text, file, url, format, images, labels, video, start, caption }),
  refName (Feldname der Spalte, wird bei jeder Verschiebung per JavaScript angepasst)
%>
<% const images = block.images || []; %>
<div class="edit-block" data-block>
    <input type="hidden" data-block-ref name="<%= refName %>" value="<%= key %>">
    <input type="hidden" name="block_<%= key %>_type" value="<%= block.type %>">

    <div class="edit-block-tools">
        <button type="button" data-block-move="up" title="Nach oben" aria-label="Baustein nach oben">&uarr;</button>
        <button type="button" data-block-move="down" title="Nach unten" aria-label="Baustein nach unten">&darr;</button>
        <button class="block-move-side" type="button" data-block-move="left" title="In die linke Spalte" aria-label="In die linke Spalte">&larr;</button>
        <button class="block-move-side" type="button" data-block-move="right" title="In die rechte Spalte" aria-label="In die rechte Spalte">&rarr;</button>
        <button class="block-remove" type="button" data-block-remove title="Entfernen" aria-label="Baustein entfernen">&times;</button>
    </div>

    <% if (block.type === 'title') { %>
    <h2 class="block-title"><textarea class="inline-field" name="block_<%= key %>_text" rows="1" data-autosize data-single-line placeholder="Zwischenüberschrift" aria-label="Zwischenüberschrift"><%= block.text || '' %></textarea></h2>
    <% } else if (block.type === 'text') { %>
    <div class="block-text"><textarea class="inline-field" name="block_<%= key %>_text" rows="3" data-autosize placeholder="Text – eine Leerzeile beginnt einen neuen Absatz" aria-label="Text"><%= block.text || '' %></textarea></div>
    <% } else if (block.type === 'image') { %>
    <%# Bei „Füllen“ wählt ein Klick (oder Ziehen) auf dem Bild den gezeigten Ausschnitt – admin.js %>
    <% const focus = Array.isArray(block.focus) ? block.focus : String(block.focus || '50,50').split(',').map(Number); %>
    <% const [focusX, focusY] = focus.length === 2 && focus.every(Number.isFinite) ? focus : [50, 50]; %>
    <figure class="block-image" data-fit="<%= block.fit === 'contain' ? 'contain' : 'cover' %>">
        <div class="zoom inline-image<%= images[0] ? '' : ' is-empty' %>" data-inline-image data-focus-area>
            <% if (images[0]) { %><input type="hidden" name="block_<%= key %>_images" value="<%= images[0] %>"><% } %>
            <input type="hidden" name="block_<%= key %>_focus" value="<%= focusX %>,<%= focusY %>" data-focus-input>
            <img src="<%= images[0] || '' %>" alt="" style="object-position: <%= focusX %>% <%= focusY %>%">
            <span class="focus-dot" style="left: <%= focusX %>%; top: <%= focusY %>%" aria-hidden="true"></span>
            <label class="inline-image-btn"><span><%= images[0] ? 'Bild ändern' : 'Bild wählen' %></span><input class="sr-only" type="file" name="block_<%= key %>_files" accept="image/jpeg,image/png,image/webp,image/gif"></label>
        </div>
        <%- include('fit-switch', { name: 'block_' + key + '_fit', value: block.fit, labels: ['Standardformat', 'Originalformat'] }) %>
        <small class="focus-hint">Ausschnitt: auf das Bild klicken oder ziehen</small>
        <input class="inline-field inline-caption" name="block_<%= key %>_caption" value="<%= block.caption || '' %>" placeholder="Bildunterschrift (optional)" aria-label="Bildunterschrift">
    </figure>
    <% } else if (block.type === 'carousel') { %>
    <figure class="carousel edit-carousel" data-fit="<%= block.fit === 'contain' ? 'contain' : 'cover' %>">
        <%- include('uploader', { key: key, images: images, multiple: true }) %>
        <%- include('fit-switch', { name: 'block_' + key + '_fit', value: block.fit }) %>
        <input class="inline-field inline-caption" name="block_<%= key %>_caption" value="<%= block.caption || '' %>" placeholder="Bildunterschrift zum Karussell (optional)" aria-label="Bildunterschrift">
    </figure>
    <% } else if (block.type === 'code') { %>
    <%# Codesample: dasselbe Fenster wie auf der Seite; die Farben kommen erst auf der Seite dazu %>
    <figure class="block-code">
        <div class="code-window">
            <div class="editor-bar"><i></i><i></i><i></i><input class="code-file" name="block_<%= key %>_file" value="<%= block.file || '' %>" maxlength="60" placeholder="Dateiname, z. B. karte.js" aria-label="Dateiname – die Endung bestimmt die Farben"></div>
            <%# Der Zeilenumbruch nach dem öffnenden Tag ist Absicht: der Browser verschluckt ihn, eine leere erste Zeile bleibt so erhalten %>
            <textarea class="code-input" name="block_<%= key %>_text" rows="6" wrap="off" spellcheck="false" autocapitalize="off" data-autosize placeholder="Code einfügen – er wird nur angezeigt, nie ausgeführt" aria-label="Code">
<%= block.text || '' %></textarea>
        </div>
        <input class="inline-field inline-caption" name="block_<%= key %>_caption" value="<%= block.caption || '' %>" placeholder="Beschreibung (optional)" aria-label="Beschreibung zum Code">
    </figure>
    <% } else if (block.type === 'compare') { %>
    <%# Vorher/Nachher: hier beide Bilder nebeneinander mit ihrer Beschriftung; auf der Seite liegen sie übereinander mit Regler %>
    <figure class="block-compare">
        <div class="edit-compare">
            <% [['before', 'Vorher'], ['after', 'Nachher']].forEach(([side, label], index) => { %>
            <div>
                <input class="inline-field edit-compare-label" name="block_<%= key %>_<%= side %>Label" value="<%= (block.labels || [])[index] || '' %>" maxlength="40" placeholder="<%= label %>" aria-label="Beschriftung <%= label %>">
                <div class="zoom inline-image<%= images[index] ? '' : ' is-empty' %>" data-inline-image>
                    <% if (images[index]) { %><input type="hidden" name="block_<%= key %>_<%= side %>" value="<%= images[index] %>"><% } %>
                    <img src="<%= images[index] || '' %>" alt="">
                    <label class="inline-image-btn"><span><%= images[index] ? 'Bild ändern' : label + '-Bild wählen' %></span><input class="sr-only" type="file" name="block_<%= key %>_<%= side %>File" accept="image/jpeg,image/png,image/webp,image/gif"></label>
                </div>
            </div>
            <% }); %>
        </div>
        <input class="inline-field inline-caption" name="block_<%= key %>_caption" value="<%= block.caption || '' %>" placeholder="Bildunterschrift (optional)" aria-label="Bildunterschrift">
    </figure>
    <% } else if (block.type === 'demo') { %>
    <%# Live-Demo: Adresse in der Leiste, Format unten rechts; auf der Seite lädt die Demo erst nach Klick auf „Starten“ %>
    <figure class="block-demo">
        <div class="demo-window">
            <div class="editor-bar"><i></i><i></i><i></i><input class="code-file" name="block_<%= key %>_url" value="<%= block.url || '' %>" placeholder="Adresse, z. B. https://koreleth.github.io/arcade-game/" aria-label="Adresse der Website oder des Spiels"></div>
            <div class="demo-stage" data-format="<%= block.format || '16-9' %>">
                <span class="demo-start" aria-hidden="true"><span class="demo-play"></span>Live-Demo starten</span>
                <label class="edit-demo-format">Format
                    <select name="block_<%= key %>_format" data-demo-format>
                        <% [['16-9', 'Breit 16:9'], ['4-3', 'Klassisch 4:3'], ['1-1', 'Quadrat 1:1']].forEach(([value, label]) => { %>
                        <option value="<%= value %>"<%= (block.format || '16-9') === value ? ' selected' : '' %>><%= label %></option>
                        <% }); %>
                    </select>
                </label>
            </div>
        </div>
        <input class="inline-field inline-caption" name="block_<%= key %>_caption" value="<%= block.caption || '' %>" placeholder="Beschreibung (optional)" aria-label="Beschreibung zur Live-Demo">
    </figure>
    <% } else if (block.type === 'youtube') { %>
    <%# YouTube-Video: Vorschaubild wie auf der Seite, die Adresse unten darauf (admin.js zeigt das Bild gleich beim Einfügen).
        Gespeichert ist nur die ID; nach einem Fehler beim Speichern steht hier noch die eingegebene Adresse %>
    <% const youtubeUrl = !block.video ? (block.url || '')
        : block.format === '9-16' ? 'https://www.youtube.com/shorts/' + block.video
        : 'https://www.youtube.com/watch?v=' + block.video + (block.start ? '&t=' + block.start + 's' : ''); %>
    <figure class="block-youtube">
        <div class="youtube<%= block.video ? '' : ' is-empty' %>" data-format="<%= block.format || '16-9' %>" data-youtube-edit>
            <img src="<%= block.video ? 'https://i.ytimg.com/vi/' + block.video + '/hqdefault.jpg' : '' %>" alt="">
            <span class="play-btn" aria-hidden="true"></span>
            <input class="youtube-url" name="block_<%= key %>_url" value="<%= youtubeUrl %>" placeholder="YouTube-Adresse einfügen, z. B. https://youtu.be/…" aria-label="Adresse des YouTube-Videos" spellcheck="false" autocomplete="off">
        </div>
        <input class="inline-field inline-caption" name="block_<%= key %>_caption" value="<%= block.caption || '' %>" placeholder="Beschreibung (optional)" aria-label="Beschreibung zum Video">
    </figure>
    <% } %>
</div>
