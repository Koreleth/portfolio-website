<%# Knöpfe eines wiederholbaren Eintrags (Abschnitt, Lebenslauf-Station) – Logik in public/js/admin.js %>
<div class="repeat-actions">
    <button class="btn btn-outline btn-small" type="button" data-move="up" aria-label="Nach oben">&uarr;</button>
    <button class="btn btn-outline btn-small" type="button" data-move="down" aria-label="Nach unten">&darr;</button>
    <button class="btn btn-danger btn-small" type="button" data-remove>Entfernen</button>
</div>
