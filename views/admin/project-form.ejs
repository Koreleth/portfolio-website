<%- include('../parts/head') %>
<%#
  Bearbeitungsmodus: die Projektseite selbst ist das Formular. Aufbau und Klassen wie in parts/productpage.ejs,
  nur sind Titel, Texte, Bilder, Tools und Abschnitte direkt an ihrer Stelle bearbeitbar. Logik in public/js/admin.js
%>
<%
  const images = project.images || [];
  const projectTools = project.tools || [];
  const categorie = categories.find(element => parseInt(element.id) === parseInt(project.categoryID));
  const title = project.title || 'Neues Projekt';
%>
<div class="edit-topbar">
    <a href="/admin#projekte">&larr; Alle Projekte</a>
    <strong><%= isNew ? 'Neues Projekt' : 'Bearbeitungsmodus' %></strong>
    <% if (!isNew && categorie) { %><a href="/portfolio/<%= categorie.slug %>/<%= project.slug %>">Ansehen</a><% } %>
</div>

<main>
<form class="admin-form page-editor" method="post" action="<%= isNew ? '/admin/projekte' : '/admin/projekte/' + project.id %>" enctype="multipart/form-data">

    <%# Kopf und Projekttext wie auf der Seite: der Eyecatcher mit dem Titelbild füllt einen Bildschirm, der Projekttext
        folgt darunter. Der ganze Bereich ist das Feld fürs Titelbild (das Bild muss das erste img darin sein) %>
    <div class="project-top inline-image<%= images[0] ? '' : ' is-empty' %>" data-inline-image<%= images[0] ? '' : ' data-required-image' %> data-fit="<%= project.coverFit === 'contain' ? 'contain' : 'cover' %>">
        <%# Eyecatcher: Felder auf dem Bild; unten rechts Darstellung und „Titelbild ändern“ %>
        <div class="project-hero">
            <span class="project-hero-media">
                <img class="project-hero-image" src="<%= images[0] || '' %>" alt="">
                <img class="project-hero-backdrop" src="<%= images[0] || '' %>" alt="" data-cover-glow>
            </span>

            <div class="upperpart">
                <div class="titletext">
                    <% if (error) { %>
                    <div class="alert alert--error" role="alert"><%= error %></div>
                    <% } %>
                    <%# Seitenpfad als Überzeile wie auf der Seite; die Kategorie wird direkt hier gewählt %>
                    <div class="breadcrumb hero-path" role="navigation" aria-label="Seitenpfad">
                        <ol>
                            <li>Portfolio</li>
                            <li>
                                <select class="inline-select" name="categoryID" required aria-label="Kategorie">
                                    <option value="">Kategorie wählen …</option>
                                    <% categories.forEach((element) => { %>
                                    <option value="<%= element.id %>"<%= categorie && element.id === categorie.id ? ' selected' : '' %>><%= element.name %></option>
                                    <% }); %>
                                </select>
                            </li>
                        </ol>
                    </div>
                    <h1><textarea class="inline-field" name="title" rows="1" required data-autosize data-single-line placeholder="Titel des Projekts" aria-label="Titel"><%= project.title || '' %></textarea></h1>
                    <div class="inline-slug">
                        <span>Adresse: /portfolio/…/</span>
                        <input class="inline-field" name="slug" value="<%= project.slug || '' %>" placeholder="wird aus dem Titel erzeugt" aria-label="URL-Name">
                    </div>
                    <p><textarea class="inline-field" name="description" rows="2" required maxlength="160" data-autosize placeholder="Kurzbeschreibung – steht auch auf der Projektkarte" aria-label="Kurzbeschreibung"><%= project.description || '' %></textarea></p>

                    <ul class="tools" data-tools-selected aria-label="Verwendete Tools"><% tools.filter(tool => projectTools.includes(tool.id)).forEach((tool) => { %><li class="tool"><%- include('../parts/tool-icon', { tool: tool }) %><%= tool.name %></li><% }); %></ul>
                    <details class="inline-tools">
                        <summary>Tools auswählen</summary>
                        <div class="tool-picker">
                            <% tools.forEach((tool) => { %>
                            <label class="tool-option">
                                <input type="checkbox" name="tools" value="<%= tool.id %>" data-name="<%= tool.name %>"<%= projectTools.includes(tool.id) ? ' checked' : '' %>>
                                <%- include('../parts/tool-icon', { tool: tool }) %>
                                <span><%= tool.name %></span>
                            </label>
                            <% }); %>
                        </div>
                        <div class="form-note">Fehlt ein Programm? <a href="/admin/tools/neu">Neues Tool anlegen</a></div>
                    </details>
                </div>
            </div>

            <div class="hero-tools">
                <%# Füllen: das Bild füllt die ganze Breite; Ganz zeigen: vollständig, z. B. für Logos %>
                <div class="hero-fit" role="radiogroup" aria-label="Darstellung des Titelbilds">
                    <% [['cover', 'Füllen'], ['contain', 'Ganz zeigen']].forEach(([value, label]) => { %>
                    <label><input class="sr-only" type="radio" name="coverFit" value="<%= value %>"<%= (project.coverFit === 'contain' ? 'contain' : 'cover') === value ? ' checked' : '' %> data-fit-input><span><%= label %></span></label>
                    <% }); %>
                </div>
                <label class="inline-image-btn"><span><%= images[0] ? 'Titelbild ändern' : 'Titelbild wählen' %></span><input class="sr-only" type="file" name="cover" accept="image/jpeg,image/png,image/webp,image/gif"></label>
            </div>
        </div>

        <div class="middlepart">
            <%# Zweites Bild; ohne eigenes zweites Bild steht auf der Seite das Titelbild %>
            <div class="middleimg">
                <div class="zoom inline-image<%= images[1] ? '' : ' is-fallback' %><%= images[0] || images[1] ? '' : ' is-empty' %>" data-inline-image>
                    <img src="<%= images[1] || images[0] || '' %>" alt="">
                    <span class="inline-image-note">Ohne zweites Bild steht hier das Titelbild</span>
                    <label class="inline-image-btn"><span><%= images[1] ? 'Bild ändern' : 'Zweites Bild wählen' %></span><input class="sr-only" type="file" name="second" accept="image/jpeg,image/png,image/webp,image/gif"></label>
                    <% if (images[1]) { %>
                    <label class="inline-image-remove"><input type="checkbox" name="removeSecond" value="1"> Entfernen</label>
                    <% } %>
                </div>
            </div>

            <div class="middletext">
                <%# Eigene Überschrift über dem Projekttext; leer gilt der Titel des Projekts (steht grau als Platzhalter da) %>
                <h2><textarea class="inline-field" name="textTitle" rows="1" data-autosize data-single-line placeholder="<%= title %>" data-mirror-placeholder="title" aria-label="Überschrift über dem Projekttext – leer steht hier der Titel"><%= project.textTitle || '' %></textarea></h2>
                <div class="inline-text"><textarea class="inline-field" name="text" rows="5" data-autosize placeholder="Projekttext – eine Leerzeile beginnt einen neuen Absatz" aria-label="Projekttext"><%= project.text || '' %></textarea></div>
            </div>
        </div>

        <%# Farbverlauf hinter dem Projekttext; steht am Ende, damit das Titelbild das erste Bild im Feld bleibt %>
        <img class="project-glow" src="<%= images[0] || '' %>" alt="" data-cover-glow>
    </div>

    <%# Weitere Abschnitte: Layout und Reihenfolge in der Leiste über jedem Abschnitt, Bausteine direkt in den Spalten %>
    <div class="project-sections">
        <div class="repeat-list" data-repeat-list="section" data-remove-title="Abschnitt entfernen?" data-remove-confirm="Der Abschnitt wird mit allen Bausteinen entfernt. Endgültig ist das erst nach dem Speichern.">
            <% (project.sections || []).forEach((section, index) => { %>
            <%- include('parts/inline-section', { key: 's' + index, section: section }) %>
            <% }); %>
        </div>
        <button class="edit-add-section" type="button" data-repeat-add="section">+ Abschnitt hinzufügen</button>
    </div>

    <%# Mitwirkende: auf der Seite nach dem letzten Abschnitt, mit Strich darüber; links die Namen, rechts ein freier Text.
        Beide leer = der Bereich erscheint nicht %>
    <div class="project-credits">
        <section class="credits">
            <div>
                <h2 class="block-title">Mitwirkende</h2>
                <div class="block-text credits-names"><textarea class="inline-field" name="contributors" rows="3" data-autosize placeholder="Namen, eine Zeile pro Person – z. B. Kamera: Name" aria-label="Namen der Mitwirkenden"><%= project.contributors || '' %></textarea></div>
            </div>
            <div class="block-text credits-text"><textarea class="inline-field" name="contributorsText" rows="3" data-autosize placeholder="Text daneben, z. B. eine Danksagung (optional). Sind beide Felder leer, erscheint dieser Bereich nicht." aria-label="Text neben den Mitwirkenden, z. B. Danksagung"><%= project.contributorsText || '' %></textarea></div>
        </section>
    </div>

    <%# Ganz unten: Speichern (bleibt beim Scrollen am unteren Rand sichtbar) %>
    <div class="edit-savebar">
        <span>Bilder bis 20 MB · Änderungen gelten erst nach dem Speichern.</span>
        <a class="btn btn-outline" href="/admin#projekte">Abbrechen</a>
        <button class="btn btn-dark" type="submit">Speichern</button>
    </div>
</form>
</main>

<%# Vorlagen: neuer Abschnitt (__KEY__) und neue Bausteine je Typ (__BLOCK__) – per JavaScript eingesetzt %>
<template data-repeat-template="section">
    <%- include('parts/inline-section', { key: '__KEY__', section: { layout: '1', valign: 'top', columns: [[]] } }) %>
</template>
<% ['title', 'text', 'image', 'carousel', 'code', 'compare', 'demo'].forEach((type) => { %>
<template data-block-template="<%= type %>">
    <%- include('parts/inline-block', { key: '__BLOCK__', block: { type: type, images: [] }, refName: '' }) %>
</template>
<% }); %>

<script src="/js/admin.js"></script>
</body>
</html>
