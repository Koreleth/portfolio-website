# Vorlage: kopiere diese Datei nach .env und trage deine Werte ein.
# Die .env selbst wird nicht committet (siehe .gitignore).

ADMIN_USER=admin

# bcrypt-Hash deines Passworts (in einfachen Anführungszeichen wegen der $-Zeichen), erzeugen mit:
# node -e "console.log(require('bcryptjs').hashSync('DEIN-PASSWORT', 12))"
ADMIN_PASSWORD_HASH='$2a$12$...'

# Langer Zufallswert zum Signieren des Login-Cookies, erzeugen mit:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=bitte-aendern
