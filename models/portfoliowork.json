                            "text": "void checkBomb (PVector bombPos, boolean bombActive) {\n  if ( ( ((pos.x) > (bombPos.x - 40) && (pos.x) < (bombPos.x + 40) )  &&  ( (pos.y) > (bombPos.y - 40) && (pos.y) < (bombPos.y + 40) ) )  ) {\n    playerInBomb = true;\n\n  } else {\n    playerInBomb = false;\n\n  }\n}",
                            "file": "bomb.js",
