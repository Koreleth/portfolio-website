<section class="timeline" id="lebenslauf">
    <h2>Lebenslauf</h2>

    <div class="timeline-container">
<% if (data.length > 0) { %>
    <% data.forEach((item) => { %>
        <div class="time-card toleft">
            <div class="time-content">
                <div class="time-cardtitle">
                  <div class="time-cardyear"><h3><%=item.time %></h3></div>
                  <div class="time-cardheader"><h3><%=item.title %></h3></div>
                </div>
                <div class="time-cardtext"><p><%=item.description %></p></div>
            </div>
        </div>
        <% }); %>
<% } %>
    </div>
</section>
